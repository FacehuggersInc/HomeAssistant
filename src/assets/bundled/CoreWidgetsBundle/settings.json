{
    "weather": {
        "timezone": {
            "type": "string",
            "default": "America/Chicago",
            "value": "America/Chicago",
            "description": "The timezone you're in"
        },
        "latitude": {
            "type": "numeric",
            "default": 41.2619,
            "value": 41.2619,
            "suffix": "deg.",
            "description": "The Latitude of your city"
        },
        "longitude": {
            "type": "numeric",
            "default": -95.8608,
            "value": -95.8608,
            "suffix": "deg.",
            "description": "The Longitude of your city"
        }
    },
    "tiles": {
        "positions": {
            "type": "string",
            "default": "{}",
            "value": "{\"clock_tile\": {\"col\": 0, \"row\": 0}}",
            "description": "JSON map of tile key to {col, row} grid positions"
        }
    },
    "credentials": {
        "wordnik_key": {
            "type": "secret",
            "env": "WORDNIK_KEY",
            "value": " ",
            "description": "Wordnik API key, for the word of the day. Stored in .env, not here."
        },
        "spotify_client_id": {
            "type": "secret",
            "env": "SPOTIFY_CLIENT_ID",
            "value": " ",
            "description": "Spotify application client ID. Stored in .env, not here."
        },
        "spotify_client_secret": {
            "type": "secret",
            "env": "SPOTIFY_CLIENT_SECRET",
            "value": " ",
            "description": "Spotify application client secret. Stored in .env, not here."
        }
    }
}